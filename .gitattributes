* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.png binary
*.jsonl text eol=lf
*.tsv text eol=lf
*.ps1 text eol=lf
# Preserve exact bytes of hash-bound experiment evidence on all platforms.
reports/cpu_pilot/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reports/reproduction_audit/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Raw upstream stdout/stderr retains its original formatting, including spaces.
reports/reproduction_audit/*.txt -whitespace
reports/sd15_clip_smoke/** -text -whitespace
*.sh text eol=lf
