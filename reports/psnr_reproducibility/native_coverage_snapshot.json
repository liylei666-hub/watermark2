  "official_source_sha256": "636dd0cb86f8b5d494e2b5213a9fdcf5001b1f4ba9705caae89ca14e9d71d12f",
  "official_source_lines": [
    {
      "line": 52,
      "text": "parser.add_argument(\"--num_inference_steps_target\", type=int, default=50)  # 20 for FLUX"
    },
    {
      "line": 58,
      "text": "parser.add_argument(\"--num_inference_steps_attacker\", type=int, default=50)"
    },
    {
      "line": 65,
      "text": "parser.add_argument(\"--lr\", type=float, default=1e-2)"
    },
    {
      "line": 109,
      "text": "diffpipe = imprint_utils.DiffPipe(pipe_attacker, scheduler=inverse_scheduler, device=pipe_attacker.device)"
    },
    {
      "line": 118,
      "text": "# set up optimization"
    },
    {
      "line": 121,
      "text": "optim = torch.optim.Adam([z0], lr=args.lr)"
    },
    {
      "line": 135,
      "text": "                                                   num_inference_steps=args.num_inference_steps_target,"
    },
    {
      "line": 145,
      "text": "                                num_inference_steps=args.num_inference_steps_attacker)"
    },
    {
      "line": 157,
      "text": "     num_inference_steps_target=args.num_inference_steps_target,"
    },
    {
      "line": 187,
      "text": "    optim.zero_grad()"
    },
    {
      "line": 189,
      "text": "    inverted_latent = diffpipe(z0, \"\", guidance_scale=1.)"
    },
    {
      "line": 196,
      "text": "    optim.step()"
    },
    {
      "line": 207,
      "text": "        image_from_z0 = imprint_utils.latent_to_pil(z0, pipe_attacker)[0]"
    },
    {
      "line": 221,
      "text": "            num_inference_steps_target=args.num_inference_steps_target,"
    }
  ],
  "model_runs_started": 0
}
